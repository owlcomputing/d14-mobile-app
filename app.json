{
  "expo": {
    "name": "AMA District 14",
    "slug": "d14-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "d14",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.owlcomputing.d14",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.owlcomputing.d14",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DUMP"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow AMA District 14 to use Face ID to lock and unlock the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AMA District 14 to use the camera to scan member QR codes and photograph documents for your wallet.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow AMA District 14 to use the camera to scan member QR codes and photograph documents for your wallet.",
          "photosPermission": "Allow AMA District 14 to add photos of your AMA card, minor release and other documents to your wallet.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#E63946"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow AMA District 14 to add events to your calendar."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "218a20cf-47a5-46be-b305-b5db72e75c9e"
      }
    },
    "owner": "dstep2007"
  }
}
